<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.yewfence.nono-approval</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.cargo/bin/nono-approval</string>
    <string>serve</string>

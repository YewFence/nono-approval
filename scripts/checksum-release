#!/usr/bin/env bash
set -euo pipefail

output_dir="${RELEASE_OUTPUT_DIR:-dist}"

mapfile -t archives < <(find "${output_dir}" -maxdepth 1 -type f -name '*.tar.gz' -printf '%f\n' | sort)
if [[ "${#archives[@]}" -eq 0 ]]; then
  echo "no release archives found in ${output_dir}"
  exit 1
fi

(
  cd "${output_dir}"
  sha256sum "${archives[@]}" > SHA256SUMS
  sha256sum --check SHA256SUMS
)

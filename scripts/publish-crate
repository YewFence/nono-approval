#!/usr/bin/env bash
set -euo pipefail

release_tag="${RELEASE_TAG:?RELEASE_TAG is required}"
release_version="${RELEASE_VERSION:?RELEASE_VERSION is required}"

metadata="$(cargo metadata --locked --no-deps --format-version 1)"
package_count="$(jq '.packages | length' <<< "${metadata}")"
if [[ "${package_count}" != "1" ]]; then
  echo "crates.io publishing requires exactly one root Cargo package"
  exit 1
fi

crate_name="$(jq -r '.packages[0].name' <<< "${metadata}")"
crate_version="$(jq -r '.packages[0].version' <<< "${metadata}")"
if [[ -z "${crate_name}" || -z "${crate_version}" || "${crate_name}" == "null" || "${crate_version}" == "null" ]]; then
  echo "cargo metadata did not resolve exactly one root package name and version"
  exit 1
fi
if [[ "${crate_version}" != "${release_version}" ]]; then
  echo "Cargo package version ${crate_version} does not match release tag ${release_tag}"
  exit 1
fi

response_file="$(mktemp)"
trap 'rm -f "${response_file}"' EXIT
status="$(curl --silent --show-error --output "${response_file}" --write-out '%{http_code}' "https://crates.io/api/v1/crates/${crate_name}/${crate_version}")"
case "${status}" in
  200)
    echo "Crate ${crate_name} ${crate_version} already exists"
    exit 0
    ;;
  404)
    echo "Crate ${crate_name} ${crate_version} is not published yet"
    ;;
  *)
    echo "Could not determine crates.io status for ${crate_name} ${crate_version}: HTTP ${status}"
    cat "${response_file}"
    exit 1
    ;;
esac

cargo publish --dry-run --package "${crate_name}" --registry crates-io --locked

if [[ -z "${CARGO_REGISTRY_TOKEN:-}" ]]; then
  echo "crates.io trusted publishing did not provide a token"
  exit 1
fi

cargo publish --package "${crate_name}" --registry crates-io --locked
